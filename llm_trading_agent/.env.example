# ============================================================
# LLM 量化交易 Agent 环境配置（.env）
# 复制本文件为 .env 后填入你的密钥：
#     cp .env.example .env     （Windows: copy .env.example .env）
# 若某项留空则使用 config.py 中的默认值。
# ============================================================

# ---------- LLM API（模型名 / 端点 / 密钥均可自由指定） ----------
# 走 OpenAI 兼容协议（POST {端点}/chat/completions），requests 裸调、无需任何 SDK。
# 任何兼容该协议的服务均可：DeepSeek / 通义千问 / 本地 Ollama / 自定义网关等。
# 密钥请到对应平台创建（DeepSeek: https://platform.deepseek.com/api_keys）
LLM_API_KEY=

# ---------- LLM 选择 ----------
# provider: deepseek（官方）/ siliconflow（硅基流动）。切换后 base_url 会按 provider 自动取默认端点。
LLM_PROVIDER=deepseek
# 模型名（用户自由指定；留空则按 provider 取默认）：
#   DeepSeek:   deepseek-chat / deepseek-reasoner
#   硅基流动:   deepseek-ai/DeepSeek-V4-Flash / deepseek-ai/DeepSeek-V4（带厂商前缀）
#   通义千问:   qwen-plus / qwen-max / qwen-turbo
#   Ollama:     llama3 / qwen2.5 等本地模型名
LLM_MODEL=
# API 端点（用户自由指定；留空则按 provider 取默认端点）：
#   DeepSeek:   https://api.deepseek.com/v1
#   硅基流动:   https://api.siliconflow.cn/v1
#   通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama:     http://localhost:11434/v1
LLM_BASE_URL=

# ---------- 交易标的与切片 ----------
SYMBOL=BTCUSDT              # 交易对：BTCUSDT / ETHUSDT / DOGEUSDT / SOLUSDT（可自由输入其它）
INTERVAL=4h                 # 切片间隔（K线周期）：15m/30m/1h/2h/4h/6h/8h/12h/1d
TRADING_MODE=spot           # 当前研究主线：spot=现货long/flat；futures=保留旧合约路径供复现
SPOT_MAX_EXPOSURE_PERCENT=75 # 现货最大市值仓位（其余至少25%现金）
SPOT_SINGLE_ORDER_PERCENT=25 # 单根K线最多增加25个百分点，实际仍受10→25→50→75分级控制
SPOT_PROBE_PERCENT=10       # 首次中/高信心BUY只建10%试探仓
SPOT_MEDIUM_TARGET_PERCENT=25 # 中信心确认后的仓位上限
SPOT_HIGH_STEP_PERCENT=50   # 高信心第二级；之后最高到75%
SPOT_MIN_REBALANCE_PERCENT=5 # 目标变化不足5个百分点不交易，降低震荡磨损
SPOT_LOW_REDUCE_PERCENT=10  # 低信心SELL减10个百分点
SPOT_MEDIUM_REDUCE_PERCENT=25 # 中信心SELL减25个百分点；高信心SELL全清
SPOT_SIZING_MODE=confidence # confidence=信心分级；fixed=固定目标；confirmed=价格确认式逐级仓位（实验）
SPOT_FIXED_TARGET_PERCENT=10 # fixed 对照的目标仓位
SPOT_ADD_MIN_BARS=2          # confirmed：两次加仓至少间隔K线数
SPOT_ADD_CONFIRM_ATR=1.0     # confirmed：价格至少高于持仓均价多少ATR才允许加仓
SPOT_DEEP_BREAK_ATR=1.0      # confirmed：低于EMA50多少ATR视为深度破位
SPOT_RISK_BUDGET_PERCENT=2.0 # confirmed：按结构止损距离估算的单仓最大权益风险
MAX_POSITION_PERCENT=20     # 单仓保证金占权益上限（%，逐仓隔离）
SINGLE_ORDER_PERCENT=5      # 单次下单保证金占权益上限（%）
MAX_LEVERAGE=10             # 最大做多杠杆（1~10，LLM 在 1~N 倍内自主选择；1=现货无杠杆）
FUNDING_RATE_PER_8H=0.0001  # 资金费率（每 8 小时按名义敞口计，0.0001=0.01%）
# ---- 交易成本（Codex #3：显式、可配置、偏保守默认；成本直接扣现金，权益即时反映）----
SIMULATE_COSTS=True         # 是否计提交易成本（机制探针可置 False）
FEE_TAKER_PCT=0.0004        # 合约 taker 手续费 0.04%/边（按单边名义敞口）
SPOT_FEE_TAKER_PCT=0.001    # 现货 taker 手续费0.10%/边（未计VIP/BNB折扣）
SLIPPAGE_PCT=0.0002         # 滑点 2bps/边（=成交价偏移的一阶等效，不改写入场/离场价）
LIQUIDATION_BUFFER=0.0      # 逐仓强平维持保证金率缓冲（0=亏损吃掉全部保证金即强平）
STOP_LOSS_RATIO=0.02        # 止损比例（2%）
TRAILING_TP_RATIO=0.05      # 移动止盈回撤比例（5%）：从持仓期最高价回撤5%即止盈
TRAILING_TP_ACTIVATE=0.02   # 移动止盈激活阈值（2%）：浮盈达2%后才启动跟踪，避免开仓初期噪音误杀
TRAILING_TP_INTRABAR=true   # 移动止盈盘中击穿检测：用high/low极值更新基准，low≤触发线即按触发线价成交（与止损同构），
                            #   消除日线「收盘才检查→大阴线穿透→实际回撤8~11%才离场」的滞后
POST_LOSS_COOLDOWN_BARS=3   # 止损冷却：同向平仓后 N 根K线禁止再开仓，打断「止损→更高价追回→再止损」锯齿磨损
REENTRY_GATE_MODE=trend     # 再入场闸门模式：trend=动态趋势锚（默认，推荐）。价格≥EMA慢线=顺势区→放行回补吃主升浪，
                            #   仅在趋势线下方的弱势反弹追高才用静态锚拦截；EMA动态跟随价格，牛市不再被永久锁死。
                            #   price=旧静态价锚（现价高于上次离场价 REENTRY_MAX_PREMIUM 即拦，回归对照用）
REENTRY_MAX_PREMIUM=0.02    # 追高拦截比例（price档：现价高于上次离场价超该比例（多2%）即暂缓回补；
                            #   trend档：仅用于趋势线下方的逆势反弹追高判定；0=关闭追高拦截（仅保留冷却期）
CHASE_DEV_START_PCT=8.0     # 高乖离追高仓位衰减阈值：新开仓现价相对趋势线(EMA50)乖离超8%（多头偏高/空头偏低）
                            #   → 不拦截、只强制降敞口（校准证明乖离硬顶会误杀大赢单，参考「强势可追但轻仓」哲学）
CHASE_DEV_DECAY_FACTOR=0.5  # 乖离超阈值时单仓保证金衰减系数（0.5=减半），缩小宽止损下的深亏绝对值
CHASE_DEV_MAX_LEVERAGE=2    # 乖离超阈值时的杠杆上限（压到≤2x）
ATR_STOP_ENABLED=true       # ATR自适应止损：止损距离 = max(固定 STOP_LOSS_RATIO, ATR_STOP_MULT×ATR14%)
ATR_STOP_MULT=1.5           # ATR止损倍数（×ATR14占价格百分比；低波动自动回落到2%保底，高波动随之放宽避免噪声扫损）
ATR_PERIOD=14               # ATR 计算周期（根）
# 回测执行成交模型（三档，只影响回测/预热；实盘 run_slice 始终按最新收盘价即时执行）：
#   intrabar —— 止损/止盈按盘中极值击穿即时成交（止损线价/移动止盈触发线价），开平仓按当根收盘价。
#               隐含「开仓即挂条件单、盘中自动成交」假设——仅当实盘真有盘中巡检/挂单时才成立。
#   close    —— 全部按当根收盘价识别并成交（与实盘 run_slice 收盘检查语义一致）。最保守：
#               单根大阴线从峰值穿透触发线时只能等收盘按收盘价离场，实际回撤=真实回撤。
#   next_open—— 当根收盘识别触发/决策（同 close），但成交延迟到次根开盘价（模拟「收盘信号+
#               次日才执行」的延迟交易者，含隔夜跳空损耗）。
EXECUTION_MODEL=next_open  # 成交模型：next_open=次根开盘成交（正式回测默认，最接近真实执行）；
                           #   intrabar/close 仅作敏感性上下界（当根信号按同根收盘成交偏乐观）
NO_AVERAGE_DOWN=true        # 禁止浮亏摊均价：加仓不重置止损线（止损锚定首仓开仓价），
                            #   防止「越跌越补→均价摊低→止损架空→亏损扩大」的死循环
EMA_TREND_PERIOD=6          # 快线周期（微观动能/信号密度，默认6）
EMA_TREND_SLOW_PERIOD=50    # 慢线周期（客观趋势方向基准/宪法拦截依据，默认50；越大越平滑、预热越长）
DAILY_LOSS_LIMIT_PERCENT=2.0   # 当日亏损熔断线（%，当天有效、次日清零）
OVERALL_LOSS_LIMIT_PERCENT=5.0 # 峰值回撤熔断线（%，相对历史峰值回撤、可自动恢复；放宽到5%以免过早打断主升浪）
EQUITY_DRAWDOWN_LIMIT_PERCENT=15.0 # 账户级回撤闸门（%，高水位永不因平仓重置；触发后需人工审查复位）
ALLOW_SHORT=false           # 是否允许做空（false=纯合约做多，SELL仅减多；
                            #   true=允许在趋势线下方SELL开空、BUY回补，空头同受仓位/熔断/止损/强平约束）
CAPITAL=100000              # 模拟本金（USDT）

# ---------- 回测 / 实盘范围 ----------
START_DATE=2025-08-10       # 回测起始日期（如 2025-08-10 或 2025-08-10 12:00）
BACKTEST_END=               # 回测截止（留空=现在；超出上限自动截取最近段）
LIVE_START=                 # 实盘曲线起点（留空=不预热直接从当前状态开始；
                            #   填写后实盘启动会先用规则引擎回放补齐该起点→当前的历史曲线）
MAX_BACKTEST_BARS=1000      # 回测/预热切片数上限（固定不超过1000）

# ---------- 行情源（主域名被屏蔽时自动切换备用） ----------
# BINANCE_BASE_URLS=https://api.binance.com,https://data-api.binance.vision

# ---------- 运行选项 ----------
# ENABLE_FREQUENT_STOP_CHECK=true   # 实盘模式每2分钟巡检一次止损
# STOP_CHECK_MINUTES=2
# BACKTEST_USE_LLM=false            # 回测是否逐K线调用真实LLM（默认规则引擎，避免巨额API费用）
# ---------- v9 LLM 决策自由度 ----------
# TREND_FILTER_LEVEL=llm            # 趋势/右侧判断归谁：engine=引擎EMA50+MACD硬拦（旧，LLM变机械根源）；
#                                   #   llm=交给LLM用K线窗口自主判断（红线仍引擎硬性）
# LLM_KLINE_WINDOW=24               # 战情简报附加近期K线窗口根数（LLM看走势形态；0=关闭；24≈350 token）
# ---------- V10 引擎护栏（Generalized 策略，详见 STRATEGY_v10_guardrail.md）----------
# 与 CLI --v10-* 等价，供 .env 固化配置；CLI 传入时优先于此处。默认全关=旧路径零影响。
# V10_ENABLED=true                  # 总开关
# V10_RL1_MODE=breach               # 红线①：breach=收盘<EMA50 强制平仓（结构止损，实跑验证；dd 已证伪）
# V10_RL1_COOL=20                   # 红线①离场后禁 BUY 根数（堵接刀；0=不冷却）
# V10_RL2=true                      # 红线②：收盘<EMA50 的 BUY 强制压杠杆至 1x（只许试探、禁重仓抄底）
